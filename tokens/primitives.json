  "space": {
    "$type": "dimension",
    "$description": "4px base grid. Half-steps exist only for dense controls.",
    "0": { "$value": "0rem" },
    "0-5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "2-5": { "$value": "0.625rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
