    "2xl": { "$value": "1rem" },
    "full": { "$value": "9999px" }
  },
  "border-width": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "thin": { "$value": "1px" },
    "thick": { "$value": "2px" }
  },
  "font-family": {
    "$type": "fontFamily",
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Sans TC', 'PingFang TC', sans-serif"
    },
    "mono": {
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "Major-second-ish scale anchored at 1rem = 16px.",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "xl": { "$value": "1.25rem" },
    "2xl": { "$value": "1.5rem" },
    "3xl": { "$value": "1.875rem" },
    "4xl": { "$value": "2.25rem" },
    "5xl": { "$value": "3rem" }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": "1.25" },
    "snug": { "$value": "1.375" },
    "normal": { "$value": "1.5" },
    "relaxed": { "$value": "1.625" }
  },
  "letter-spacing": {
    "$type": "dimension",
    "tight": { "$value": "-0.01em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.02em" }
  },
  "size": {
    "$type": "dimension",
    "$description": "Control heights. Every interactive control snaps to one of these.",
    "control-sm": { "$value": "1.75rem" },
    "control-md": { "$value": "2.25rem" },
    "control-lg": { "$value": "2.75rem" },
    "icon-sm": { "$value": "1rem" },
    "icon-md": { "$value": "1.25rem" },
    "icon-lg": { "$value": "1.5rem" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "0ms" },
    "fast": { "$value": "120ms" },
    "normal": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "entrance": { "$value": "cubic-bezier(0, 0, 0, 1)" },
    "exit": { "$value": "cubic-bezier(0.3, 0, 1, 1)" }
  },
  "z-index": {
    "$type": "number",
    "base": { "$value": "0" },
    "dropdown": { "$value": "1000" },
    "sticky": { "$value": "1100" },
    "overlay": { "$value": "1200" },
    "modal": { "$value": "1300" },
    "popover": { "$value": "1400" },
    "toast": { "$value": "1500" },
    "tooltip": { "$value": "1600" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" },
    "xl": { "$value": "80rem" }
